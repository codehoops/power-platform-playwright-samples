{
  "name": "@power-platform-playwright/test-builder-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Test Builder UI for Power Platform Playwright — record, manage, and run Playwright tests via a Fluent UI web interface",
  "scripts": {
    "build:server": "tsc -p tsconfig.json",
    "build:client": "cd client && npm run build",
    "build": "npm run build:server && npm run build:client",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "cd client && npm run dev",
    "start": "node dist/server/index.js"
  },
  "dependencies": {
    "@azure/msal-node": "^2.16.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "uuid": "^11.0.5",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.14",
    "tsx": "^4.21.0",
    "typescript": "^5.4.0"
  }
}
